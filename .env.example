SECRET_KEY=change-me-to-a-long-random-string
SHOP_NAME=Nama Car Wash
SHOP_PHONE=
TIMEZONE=Asia/Brunei
OPEN_TIME=09:00
CLOSE_TIME=18:00
SLOT_MINUTES=15
WASH_BAYS=1
BOOKING_WINDOW_DAYS=30

# First staff account (Docker creates it on start if missing)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Let the first visitor to /admin create a staff account when none exist (off in Docker)
# ALLOW_FIRST_ADMIN_SIGNUP=1

# Database (defaults to SQLite in instance/car_wash.db)
# DATABASE_URL=postgresql://user:password@localhost/car_wash

# Booking confirmations. Fill in the keys here, then switch each one on or off
# in the staff area under Settings. A channel without keys stays off.

# Text messages through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MESSAGING_SERVICE=
SMS_COUNTRY_CODE=+673

# Email through Resend (https://resend.com). RESEND_FROM must use a domain verified in Resend.
RESEND_API_KEY=
# e.g. RESEND_FROM=Nama Car Wash <bookings@namacarwash.com>
RESEND_FROM=
RESEND_REPLY_TO=
